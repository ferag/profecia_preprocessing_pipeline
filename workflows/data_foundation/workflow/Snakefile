from pathlib import Path
import sys


config.setdefault("user_settings", "")

release = config["release"]
sources = config["sources"]
selected = config.get("selected_variables", [])
derived = config.get("derived_products", [])
canonical_refs = config.get("canonical_reference_products", {})

RELEASE_ID = release["id"]
BASE_DIR = release["base_dir"]
WORKFLOW_DIR = workflow.basedir
SCRIPT_DIR = f"{WORKFLOW_DIR}/scripts"
CONFIG_PATH = str(workflow.configfiles[0]) if workflow.configfiles else "workflows/data_foundation/config/data_foundation_demo.yml"
PYTHON = sys.executable



def derived_products():
    return [item for item in derived if item.get("id") and item.get("output_filename")]


def derived_output(item):
    kind = str(item.get('temporal_resolution', 'monthly')).lower()
    folder = 'annual' if kind == 'annual' else ('static' if kind == 'static' else 'monthly')
    return f"{BASE_DIR}/{folder}/{item['output_filename']}"


def selected_pairs():
    return [(item["source"], item["variable"]) for item in selected]


def source_config(source):
    return sources[source]


def variable_config(source, variable):
    return sources[source]["variables"][variable]


def canonical_reference(kind, variable):
    return canonical_refs.get(f"{kind}/{variable}", "")


def has_canonical_reference(kind, variable):
    return bool(canonical_reference(kind, variable))


def variable_has_canonical_reference(source, variable):
    return bool(variable_config(source, variable).get("canonical_reference_path"))


def skip_api_acquisition(source, variable):
    if variable_has_canonical_reference(source, variable):
        return True
    if source == "carbontracker_co2" and variable == "co2" and has_canonical_reference("annual", "co2"):
        return True
    return False


def static_monthly_source(variable):
    if variable in {"ph", "bulk", "cec", "clay", "sand", "silt", "soc", "total_n"}:
        return "resources/source_data/static/hwsd2_soil_0p5_100cm.nc"
    return f"resources/source_data/static/{variable}_0.5deg.nc"


def hwsd2_uses_canonical_reference():
    return bool(sources.get("hwsd2", {}).get("canonical_reference_dir"))


def access_mode(source):
    return source_config(source).get("access_mode", "manual")


def is_manual_mode(source):
    return access_mode(source) in {"manual", "manual_or_internal"}


def is_source_bundle(source):
    return bool(source_config(source).get("data_files")) or access_mode(source) in {"usgs_authenticated"}


def adapter(source):
    return source_config(source).get("adapter", source)


def request_path(source, variable):
    return f"{BASE_DIR}/metadata/{source}/{variable}/request.json"


def manual_inventory_path(source, variable):
    return f"{BASE_DIR}/metadata/{source}/{variable}/manual_inventory.json"


def raw_path(source, variable):
    filename = variable_config(source, variable)["output_filename"]
    return f"{BASE_DIR}/raw/{source}/{variable}/{filename}"


def source_file_list_path(source):
    return f"{BASE_DIR}/metadata/{source}/file_list.json"


def source_download_report_path(source):
    return f"{BASE_DIR}/metadata/{source}/download_report.json"


def source_raw_dir(source):
    return f"{BASE_DIR}/raw/{source}"


def inspection_path(source, variable):
    return f"{BASE_DIR}/validation/{source}/{variable}/inspection.json"


def variable_temporal_kind(source, variable):
    var = variable_config(source, variable)
    text = " ".join(
        str(var.get(key, "")).lower()
        for key in ("data_structure", "dimensionality", "native_temporal_resolution")
    )
    filename = str(var.get("output_filename", "")).lower()
    if "static" in text:
        return "static"
    if "annual" in text or "annual" in filename:
        return "annual"
    if "monthly" in text or "monthly" in filename or var.get("months"):
        return "monthly"
    return "static"


def harmonized_monthly_path(source, variable):
    return f"{BASE_DIR}/monthly/{source}_{variable}_monthly_0.5deg.nc"


def harmonized_annual_path(source, variable):
    return f"{BASE_DIR}/annual/{source}_{variable}_annual_0.5deg.nc"


def harmonized_static_path(source):
    if source == "hwsd2":
        return f"{BASE_DIR}/static/hwsd2_soil_0.5deg.nc"
    return f"{BASE_DIR}/static/{source}_static_0.5deg.nc"


def harmonized_validation_path():
    return f"{BASE_DIR}/validation/harmonized_validation.json"


API_PAIRS = [
    (source, variable)
    for source, variable in selected_pairs()
    if access_mode(source) in {"api", "http", "usgs_authenticated"} and not is_source_bundle(source)
    and not skip_api_acquisition(source, variable)
]
HARMONIZABLE_API_PAIRS = [
    (source, variable)
    for source, variable in selected_pairs()
    if access_mode(source) in {"api", "http", "usgs_authenticated"} and not is_source_bundle(source)
    and not (source == "carbontracker_co2" and variable == "co2" and has_canonical_reference("annual", "co2"))
]
MANUAL_PAIRS = [(source, variable) for source, variable in selected_pairs() if is_manual_mode(source)]
BUNDLE_SOURCES = sorted(
    {
        source
        for source, _ in selected_pairs()
        if access_mode(source) in {"api", "http", "usgs_authenticated"} and is_source_bundle(source)
    }
)

REQUESTS = [request_path(source, variable) for source, variable in API_PAIRS]
RAW_OUTPUTS = [raw_path(source, variable) for source, variable in API_PAIRS]
MANUAL_INVENTORIES = [manual_inventory_path(source, variable) for source, variable in MANUAL_PAIRS]
BUNDLE_FILE_LISTS = [source_file_list_path(source) for source in BUNDLE_SOURCES]
BUNDLE_DOWNLOAD_REPORTS = [source_download_report_path(source) for source in BUNDLE_SOURCES]
BUNDLE_RAW_DIRS = [source_raw_dir(source) for source in BUNDLE_SOURCES]
INSPECTIONS = [inspection_path(source, variable) for source, variable in API_PAIRS]

HARMONIZED_MONTHLY_PAIRS = [
    (source, variable)
    for source, variable in HARMONIZABLE_API_PAIRS
    if variable_temporal_kind(source, variable) == "monthly"
]
HARMONIZED_ANNUAL_PAIRS = [
    (source, variable)
    for source, variable in HARMONIZABLE_API_PAIRS
    if variable_temporal_kind(source, variable) == "annual"
]
HARMONIZED_STATIC_SOURCES = sorted(
    {
        source
        for source, variable in selected_pairs()
        if variable_temporal_kind(source, variable) == "static" and is_source_bundle(source)
    }
)
HARMONIZED_MONTHLY_OUTPUTS = [
    harmonized_monthly_path(source, variable) for source, variable in HARMONIZED_MONTHLY_PAIRS
]
HARMONIZED_ANNUAL_OUTPUTS = [
    harmonized_annual_path(source, variable) for source, variable in HARMONIZED_ANNUAL_PAIRS
]
HARMONIZED_STATIC_OUTPUTS = [
    harmonized_static_path(source) for source in HARMONIZED_STATIC_SOURCES
]
DERIVED_OUTPUTS = [derived_output(item) for item in derived_products()]
HARMONIZED_OUTPUTS = HARMONIZED_MONTHLY_OUTPUTS + HARMONIZED_ANNUAL_OUTPUTS + HARMONIZED_STATIC_OUTPUTS + DERIVED_OUTPUTS
HARMONIZED_VALIDATION = harmonized_validation_path()

MANIFEST = f"{BASE_DIR}/manifest.json"
CHECKSUMS = f"{BASE_DIR}/checksums.sha256"
CROISSANT = f"{BASE_DIR}/fair/harmonized_netcdf_demo.croissant.jsonld"
RELEASE_VALIDATION = f"{BASE_DIR}/validation/release_validation.json"
RO_CRATE_DIR = f"{BASE_DIR}/ro-crate"
RO_CRATE_METADATA = f"{RO_CRATE_DIR}/ro-crate-metadata.json"
RO_CRATE_README = f"{RO_CRATE_DIR}/README.md"
RO_CRATE_ARCHIVE = f"{BASE_DIR}/ro-crate.zip"


def wildcard_regex(values):
    return "|".join(values) if values else "a^"


SELECTED_SOURCES = sorted({source for source, _ in selected_pairs()})
SELECTED_VARIABLES = sorted({variable for _, variable in selected_pairs()})


include: "rules/acquire.smk"
include: "rules/inspect.smk"
include: "rules/harmonize.smk"
include: "rules/metadata.smk"
include: "rules/validate.smk"


rule all:
    input:
        manifest=MANIFEST,
        checksums=CHECKSUMS,
        croissant=CROISSANT,
        raw_outputs=RAW_OUTPUTS,
        manual_inventories=MANUAL_INVENTORIES,
        bundle_file_lists=BUNDLE_FILE_LISTS,
        bundle_download_reports=BUNDLE_DOWNLOAD_REPORTS,
        bundle_raw_dirs=BUNDLE_RAW_DIRS,
        inspections=INSPECTIONS,
        harmonized_outputs=HARMONIZED_OUTPUTS,
        harmonized_validation=HARMONIZED_VALIDATION,
        release_validation=RELEASE_VALIDATION,
        ro_crate_metadata=RO_CRATE_METADATA,
        ro_crate_readme=RO_CRATE_README,
        ro_crate_archive=RO_CRATE_ARCHIVE
